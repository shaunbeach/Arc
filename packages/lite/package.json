{
	"name": "pi-lite",
	"version": "0.0.1",
	"description": "Lean terminal coding harness for local llama.cpp models",
	"keywords": ["llama.cpp", "llama-server", "local-llm", "coding-agent", "terminal"],
	"author": "Shaun Beach",
	"homepage": "https://github.com/shaunbeach/pi-lite#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shaunbeach/pi-lite.git",
		"directory": "packages/lite"
	},
	"bugs": {
		"url": "https://github.com/shaunbeach/pi-lite/issues"
	},
	"type": "module",
	"bin": {
		"pi-lite": "dist/pi-lite.js"
	},
	"files": ["dist/pi-lite.js"],
	"scripts": {
		"build": "node scripts/build.mjs",
		"dev": "node src/cli.ts",
		"test": "vitest --run",
		"prepack": "node scripts/build.mjs && node scripts/copy-docs.mjs"
	},
	"devDependencies": {
		"@earendil-works/pi-tui": "^0.85.1",
		"diff": "8.0.4",
		"esbuild": "0.28.2",
		"partial-json": "0.1.7",
		"typebox": "1.3.27",
		"vitest": "4.1.9",
		"yaml": "2.9.0"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"license": "MIT"
}
